{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-release",
            "displayName": "Windows — Release (MinGW cross-compile)",
            "description": "Compiles for Windows using MinGW on Linux; produces a static .exe.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-release",
            "toolchainFile": "${sourceDir}/cmake/toolchain-windows-template.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.10"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows — Debug (MinGW cross-compile)",
            "description": "Same toolchain with debug symbols.",
            "inherits": "windows-release",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux — Release",
            "description": "Compiles for Linux; produces a static executable.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.10"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux — Debug",
            "description": "Same toolchain with debug symbols.",
            "inherits": "linux-release",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "windows-release-clean",
            "displayName": "Windows — Release (clean first)",
            "description": "Deletes previous build artifacts before rebuilding. Dependencies in external/ are preserved.",
            "configurePreset": "windows-release",
            "cleanFirst": true
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-debug-clean",
            "displayName": "Windows — Debug (clean first)",
            "description": "Deletes previous build artifacts before rebuilding. Dependencies in external/ are preserved.",
            "configurePreset": "windows-debug",
            "cleanFirst": true
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-release-clean",
            "displayName": "Linux — Release (clean first)",
            "description": "Deletes previous build artifacts before rebuilding. Dependencies in external/ are preserved.",
            "configurePreset": "linux-release",
            "cleanFirst": true
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-debug-clean",
            "displayName": "Linux — Debug (clean first)",
            "description": "Deletes previous build artifacts before rebuilding. Dependencies in external/ are preserved.",
            "configurePreset": "linux-debug",
            "cleanFirst": true
        }
    ]
}
